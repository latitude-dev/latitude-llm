# ================================================================
# Latitude Infrastructure
# These are consumed directly by the Docker containers.
# ================================================================

# Postgres
POSTGRES_USER=latitude
# Change for production
POSTGRES_PASSWORD=secret
# Change to "latitude" for production
POSTGRES_DB=latitude_development
# Runtime user: a restricted Postgres user subject to RLS (created by docker/init-db.sh)
POSTGRES_RUNTIME_USER=latitude_app
# Change for production
POSTGRES_RUNTIME_PASSWORD=secret

# ClickHouse
CLICKHOUSE_USER=latitude
# Change for production
CLICKHOUSE_PASSWORD=secret
# Change to "latitude" for production
CLICKHOUSE_DB=latitude_development

# Node
# Change to "production" for production
NODE_ENV=development

# Self-host (optional - overrides the published image tag that docker-stack.yml pulls)
# LAT_IMAGE_TAG=latest

# ================================================================
# Latitude Application
# All application env vars are prefixed with LAT_.
# ================================================================

# OLAP database (when applies these must match the CLICKHOUSE_* values above)
# Change to "http://clickhouse:8123" for production
LAT_CLICKHOUSE_URL=http://localhost:8123
LAT_CLICKHOUSE_USER=latitude
# Change for production
LAT_CLICKHOUSE_PASSWORD=secret
# Change to "latitude" for production
LAT_CLICKHOUSE_DB=latitude_development
# Migration tooling (goose): host and port only; credentials and database are taken from the LAT_CLICKHOUSE_* values above
# Change to "clickhouse://clickhouse:9000" for production
LAT_CLICKHOUSE_MIGRATION_URL=clickhouse://localhost:9000
LAT_CLICKHOUSE_CLUSTER_ENABLED=false

# Application database (runtime user — subject to RLS)
# Change to "postgres://latitude_app:secret@postgres:5432/latitude" for production
LAT_DATABASE_URL=postgres://latitude_app:secret@localhost:5432/latitude_development
LAT_PG_POOL_MAX=20
LAT_PG_IDLE_TIMEOUT_MS=30000
LAT_PG_CONNECT_TIMEOUT_MS=10000
# Admin database (superuser — bypasses RLS; used by drizzle-kit, seeds, and cross-org runtime queries)
# Change to "postgres://latitude:secret@postgres:5432/latitude" for production
LAT_ADMIN_DATABASE_URL=postgres://latitude:secret@localhost:5432/latitude_development

# Cache
# Change to "redis" for production
LAT_REDIS_HOST=localhost
LAT_REDIS_PORT=6379
# LAT_REDIS_TLS=true
# LAT_REDIS_CLUSTER=true

# BullMQ Queue
# Change to "redis-bullmq" for production
LAT_BULLMQ_HOST=localhost
# Change to "6379" for production
LAT_BULLMQ_PORT=6380
# LAT_BULLMQ_PASSWORD=
# LAT_BULLMQ_CLUSTER=true
# Bull board queue dashboard (optional): served at /bull-board on the workers
# health port only while BOTH credentials are set.
# Remove for production
LAT_BULL_BOARD_USERNAME=admin
# Remove for production
LAT_BULL_BOARD_PASSWORD=admin

# Temporal
# Change to "temporal:7233" for production
LAT_TEMPORAL_ADDRESS=localhost:7233
LAT_TEMPORAL_NAMESPACE=default
LAT_TEMPORAL_TASK_QUEUE=latitude-workflows
# Temporal Cloud: use regional host, your namespace id, and an API key from the Cloud UI
# LAT_TEMPORAL_ADDRESS=eu-central-1.aws.api.temporal.io:7233
# LAT_TEMPORAL_NAMESPACE=your-namespace.account-id
# LAT_TEMPORAL_API_KEY=
# LAT_TEMPORAL_MAX_CONCURRENT_ACTIVITY_TASKS=4
# LAT_WORKFLOWS_HEALTH_PORT=9091
# Local UI (docker compose temporal-ui): http://localhost:8233

# Object Storage
# (bundled SeaweedFS, or any managed/S3-compatible store; all services share it).
# Change to "s3" for production
LAT_STORAGE_DRIVER=fs
# Absolute path for the local fs object store (created automatically if missing)
LAT_STORAGE_FS_ROOT=/tmp/latitude
# Uncomment for production. Values shown are for the bundled SeaweedFS; for
# managed/AWS S3 use your bucket/keys and omit the endpoint + force-path-style lines.
# LAT_STORAGE_S3_BUCKET=latitude
# LAT_STORAGE_S3_REGION=eu-central-1
# LAT_STORAGE_S3_ACCESS_KEY_ID=latitude
# LAT_STORAGE_S3_SECRET_ACCESS_KEY=secret
# LAT_STORAGE_S3_ENDPOINT=http://seaweedfs:8333
# LAT_STORAGE_S3_FORCE_PATH_STYLE=true

# Export request rate limiting
# LAT_EXPORT_RATE_LIMIT_MAX_REQUESTS=10
# LAT_EXPORT_RATE_LIMIT_WINDOW_SECONDS=3600

# Ports and URLs — for production set the *_URL values to your real public URLs
# (https, behind a TLS reverse proxy); the *_PORT values can stay.
# Change to "https://your-domain" for production
LAT_WEB_URL=http://localhost:3000
LAT_WEB_PORT=3000
# Change to "https://api.your-domain" for production
LAT_API_URL=http://localhost:3001
LAT_API_PORT=3001
# Change to "https://ingest.your-domain" for production
LAT_INGEST_URL=http://localhost:3002
LAT_INGEST_PORT=3002
# Per organization+API key trace ingest burst limits
# LAT_INGEST_TRACE_RATE_LIMIT_MAX_REQUESTS=1000
# LAT_INGEST_TRACE_RATE_LIMIT_MAX_BYTES=67108864
# LAT_INGEST_TRACE_RATE_LIMIT_WINDOW_SECONDS=60
# Per-process trace payload memory protection
# LAT_INGEST_TRACE_MAX_PAYLOAD_BYTES=33554432
# LAT_INGEST_TRACE_MAX_IN_FLIGHT_BYTES=67108864
# LAT_INGEST_TRACE_MAX_CONCURRENT_PAYLOADS=16
# Dev/QA only: shrink the destinations sweep window-end safety lag (ms) so freshly
# seeded spans become eligible in ~1 min instead of ~6. Ignored in production (5-min default).
# LAT_DEV_DESTINATIONS_SAFETY_LAG_MS=30000
# LAT_WORKERS_HEALTH_PORT=9090

# Master encryption key (32-byte hex key for AES-256-GCM)
# Generate a unique value for production (openssl rand -hex 32)
LAT_MASTER_ENCRYPTION_KEY=75d697b90c1e46c13bd7f7343ab2b9a9e430cdcda05d47f055e1523d54d5409b

# GEPA optimizer (optional overrides, auto-detected by default)
# LAT_GEPA_PYTHON_ROOT=/Users/YOUR_NAME/src/latitude-v2/packages/platform/op-gepa/python
# LAT_GEPA_PYTHON_EXECUTABLE=/Users/YOUR_NAME/src/latitude-v2/packages/platform/op-gepa/python/.venv/bin/python
# LAT_GEPA_SEED=310700

# Better Auth
# Generate a unique value for production (openssl rand -hex 32)
LAT_BETTER_AUTH_SECRET=bd84f86b2cc1011da17d68e5a808f873d30383bc3717c4e770629e4f3b55b7da

# Cloudflare Turnstile (optional - bot protection)
# LAT_TURNSTILE_SECRET_KEY=0x...
# VITE_LAT_TURNSTILE_SITE_KEY=0x...

# Email domain restriction (staging only), when set, only emails from this domain are allowed to sign up or sign in.
# LAT_ALLOWED_EMAIL_DOMAIN=latitude.so

# Web / CORS
# Change to "https://your-domain" for production
LAT_TRUSTED_ORIGINS=http://localhost:3000
# Change to "https://your-domain" for production
LAT_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email: Mailpit (choose one)
LAT_MAILPIT_HOST=localhost
LAT_MAILPIT_PORT=1025
LAT_MAILPIT_FROM=noreply@latitude.local

# Email: Mailgun (optional)
# LAT_MAILGUN_API_KEY=key-xxx
# LAT_MAILGUN_DOMAIN=mg.yourdomain.com
# LAT_MAILGUN_FROM=noreply@yourdomain.com
# LAT_MAILGUN_REGION=us

# Email: SMTP (optional, e.g. SendGrid SMTP, AWS SES)
# LAT_SMTP_HOST=smtp.sendgrid.net
# LAT_SMTP_PORT=587
# LAT_SMTP_USER=apikey
# LAT_SMTP_PASS=your-sendgrid-api-key
# LAT_SMTP_FROM=noreply@yourdomain.com

# Email: SendGrid API (optional)
# LAT_SENDGRID_API_KEY=SG.xxx
# LAT_SENDGRID_FROM=noreply@yourdomain.com

# OAuth Providers (optional)
# LAT_GOOGLE_CLIENT_ID=your-google-client-id
# LAT_GOOGLE_CLIENT_SECRET=your-google-client-secret
# LAT_GITHUB_CLIENT_ID=your-github-client-id
# LAT_GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub App (integration; distinct from the GitHub SSO OAuth app above)
# LAT_GITHUB_APP_ID=your-github-app-id
# LAT_GITHUB_APP_SLUG=your-github-app-slug
# LAT_GITHUB_APP_PRIVATE_KEY=base64-of-the-app-private-key-pem
# LAT_GITHUB_WEBHOOK_SECRET=your-github-app-webhook-secret
# LAT_GITHUB_APP_CLIENT_ID=your-github-app-client-id
# LAT_GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
# Only for GitHub Enterprise Server; leave unset for github.com
# LAT_GITHUB_BASE_URL=

# Amazon Bedrock (default generation provider; also a reranking provider)
LAT_AWS_REGION=eu-central-1
# LAT_AWS_ACCESS_KEY_ID=
# LAT_AWS_SECRET_ACCESS_KEY=
# LAT_AWS_SESSION_TOKEN=
# LAT_AWS_BEARER_TOKEN_BEDROCK=

# Voyage AI (default embeddings + reranking provider)
LAT_VOYAGE_API_KEY=

# Anthropic (optional generation provider; also used by the dev-only flagger-optimization tooling)
# LAT_ANTHROPIC_API_KEY=

# OpenAI (optional generation + embeddings provider)
# LAT_OPENAI_API_KEY=

# Google (optional generation + embeddings provider)
# LAT_GOOGLE_API_KEY=

# Custom OpenAI-compatible endpoint (optional generation + embeddings provider:
# Ollama, vLLM, LM Studio, any gateway). The API key is optional for local servers.
# LAT_CUSTOM_AI_BASE_URL=http://localhost:11434/v1
# LAT_CUSTOM_AI_API_KEY=

# Generation model selection (optional). Each feature resolves every setting as
# LAT_AI_<FEATURE>_<SETTING> -> LAT_AI_GENERATION_<SETTING> -> built-in default
# where <SETTING> is PROVIDER | MODEL | REASONING | TEMPERATURE | MAX_TOKENS,
# providers are amazon-bedrock | anthropic | openai | google | custom, and
# REASONING is none | provider-default | minimal | low | medium | high | xhigh.
# Always set PROVIDER and MODEL together — model ids are provider-specific.
# LAT_AI_GENERATION_PROVIDER=
# LAT_AI_GENERATION_MODEL=
# Feature keys and their built-in defaults:
#   ISSUE_DETAILS_GENERATOR  amazon-bedrock / minimax.minimax-m2.5 / reasoning high
#   FLAGGER_CLASSIFIER       amazon-bedrock / anthropic.claude-haiku-4-5-20251001-v1:0 / temperature 0, maxTokens 512
#   FLAGGER_EXTRACTOR        amazon-bedrock / minimax.minimax-m2.5 / temperature 0, maxTokens 512
#   FLAGGER_ANNOTATOR        amazon-bedrock / minimax.minimax-m2.5 / temperature 0.2, maxTokens 2048
#   ANNOTATION_ENRICHER      amazon-bedrock / minimax.minimax-m2.5 / reasoning medium
#   EVALUATION_JUDGE         amazon-bedrock / minimax.minimax-m2.5 / reasoning low
#   TAXONOMY_NAMING          amazon-bedrock / minimax.minimax-m2.5 / temperature 0.2
#   GEPA_PROPOSER            amazon-bedrock / anthropic.claude-sonnet-4-6 / reasoning high
#   MOMENT_CLASSIFIER        amazon-bedrock / minimax.minimax-m2.5 / temperature 0, maxTokens 2048
# Example: LAT_AI_FLAGGER_CLASSIFIER_PROVIDER=openai + LAT_AI_FLAGGER_CLASSIFIER_MODEL=gpt-5.2

# Embeddings (global — no per-feature vars). Providers: voyage | openai | google | custom.
# The model MUST emit 2048-dimensional vectors (hard-coded into the ClickHouse
# message_embeddings CHECK + HNSW index). A model with any other dimension makes
# every embedding insert fail the CHECK; switching dimensions requires a new
# migration that recreates the table — it cannot be flipped via env alone.
# ONE-TIME CHOICE: pick the embedding model at install time and keep it —
# different models produce incompatible vector spaces and Latitude never
# re-embeds existing data, so switching breaks semantic search and clustering.
# LAT_AI_EMBEDDING_PROVIDER=voyage
# LAT_AI_EMBEDDING_MODEL=voyage-4-large

# Reranking (global). Providers: voyage | amazon-bedrock.
# LAT_AI_RERANKING_PROVIDER=voyage
# LAT_AI_RERANKING_MODEL=rerank-2.5

# Taxonomy adaptive-clustering rollout baseline: off | shadow | enforced.
# Environment-wide kill switch and shadow toggle for the divisive-build rollout,
# read only in the gardening planning activity. `off` (default, and any
# unrecognized value) keeps the byte-identical static path; `shadow`/`enforced`
# exercise the adaptive builder, member-confidence routing thresholds,
# shape-aware naming, and the staging + atomic-swap full-window publish path.
# The per-organization enforcement flag (adaptiveTaxonomyClustering) ships in a
# later phase and can only raise this baseline to `enforced`.
# LAT_TAXONOMY_ADAPTIVE_CLUSTERING_MODE=off

# Slack (optional)
# LAT_SLACK_CLIENT_ID=
# LAT_SLACK_CLIENT_SECRET=
# LAT_SLACK_SIGNING_SECRET=

# Stripe (optional)
# LAT_STRIPE_SECRET_KEY=sk_test_xxx
# LAT_STRIPE_WEBHOOK_SECRET=whsec_xxx
# LAT_STRIPE_PRO_PRICE_ID=price_xxx
# LAT_STRIPE_PRO_OVERAGE_PRICE_ID=price_xxx
# LAT_STRIPE_PRO_OVERAGE_METER_EVENT_NAME=latitude_pro_overage_credits

# Datadog (optional - APM observability via Datadog Agent Sidecar)
# Enable OTEL startup in services that call initializeObservability
# LAT_OBSERVABILITY_ENABLED=false
# Deployment environment tag (defaults to NODE_ENV when omitted)
# LAT_OBSERVABILITY_ENVIRONMENT=development
# Optional default service override; each app passes its own serviceName
# LAT_OBSERVABILITY_SERVICE_NAME=
# OTLP traces endpoint (apps send to Datadog Agent sidecar)
# LAT_OBSERVABILITY_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Optional comma-separated OTLP headers (key=value,key2=value2)
# LAT_OBSERVABILITY_OTLP_HEADERS=
# Optional: also export spans to Latitude when the API key is set (ECS sets it in prod). The same API
# key is reused by @platform/latitude-api to write product-feedback annotations (Latitude-on-Latitude
# dogfood); when unset, the client no-ops. Auth is org-scoped, so this one key reaches every project.
# Internal AI features route to per-feature projects via hard-coded slugs (LATITUDE_TELEMETRY_PROJECT_SLUGS
# in @domain/shared) — there is no project-slug env var.
# LAT_LATITUDE_TELEMETRY_API_KEY=lat_seed_default_api_key_token
# Latitude OTLP ingest origin (default https://ingest.latitude.so); use http://localhost:3002 for local ingest
# LAT_LATITUDE_TELEMETRY_INGEST_URL=
# Latitude public API origin used by @platform/latitude-api (default https://api.latitude.so);
# use http://localhost:3001 for local-loopback dogfood.
# LAT_LATITUDE_API_URL=

# Intercom (optional - support chat)
# Intercom Workspace ID (publicly safe — embedded in the widget config).
# LAT_V2_SUPPORT_APP_ID=
# Intercom's "Identity Verification" secret used to HMAC-sign
# LAT_V2_SUPPORT_APP_SECRET_KEY=

# PostHog (optional — analytics + session recordings)
# LAT_POSTHOG_API_KEY=
# LAT_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_LAT_POSTHOG_KEY=
# VITE_LAT_POSTHOG_HOST=https://eu.i.posthog.com

# OSS deployment telemetry (optional — anonymous PostHog heartbeat for self-hosted installs)
# Enabled by default in production; set to false to opt out.
# LAT_OSS_TELEMETRY_ENABLED=false
# LAT_OSS_TELEMETRY_POSTHOG_API_KEY=phc_...
# LAT_OSS_TELEMETRY_POSTHOG_HOST=https://eu.i.posthog.com

# Changelog (optional - override marketing-site API base URL for local testing)
# LAT_CHANGELOG_API_BASE_URL=https://latitude.so

# Google Tag Manager (optional — analytics + event recordings)
# VITE_LAT_GTM_CONTAINER_ID=

# IPinfo.io token (optional — backoffice Sessions panel GeoIP lookup)
# LAT_IPINFO_TOKEN=

# Loops (optional - marketing/lifecycle emails)
# LAT_LOOPS_API_KEY=
