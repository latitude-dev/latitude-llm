{
  "name": "latitude-llm",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "turbo check",
    "hooks": "node ./scripts/setup-git-hooks.mjs",
    "format": "turbo format",
    "tmux": "tmuxinator start .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:regression": "turbo test:regression",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:fix:files": "knip --fix-type files --allow-remove-files",
    "clean": "node ./scripts/clean-repo.mjs",
    "db:reset": "pnpm --filter \"@platform/db-postgres\" pg:reset && pnpm --filter \"@platform/db-clickhouse\" ch:reset",
    "db:up": "pnpm --filter \"@platform/db-postgres\" pg:migrate && pnpm --filter \"@platform/db-clickhouse\" ch:up",
    "seed": "pnpm --filter \"@platform/db-postgres\" pg:seed && pnpm --filter \"@platform/db-clickhouse\" ch:seed",
    "migrate": "pnpm --filter \"@platform/db-postgres\" pg:migrate && pnpm --filter \"@platform/db-clickhouse\" ch:up",
    "reset": "pnpm clean && pnpm install && pnpm build && pnpm db:reset",
    "catchup": "pnpm clean && pnpm install && pnpm build && pnpm db:up",
    "openapi:emit": "pnpm --filter @app/api openapi:emit",
    "mcp:emit": "pnpm --filter @app/api mcp:emit",
    "mcp:inspect": "pnpm --filter @app/api mcp:inspect",
    "fern:check": "./fern/invoke.sh check",
    "generate:sdk:typescript": "./fern/invoke.sh generate --group local-typescript --local --force --version \"$(grep -m1 '\"version\":' packages/sdk/typescript/package.json | sed -E 's/.*\"version\": *\"([^\"]+)\".*/\\1/')\"",
    "generate:sdk:python": "./fern/invoke.sh generate --group local-python --local --force --version \"$(grep -m1 '^version' packages/sdk/python/pyproject.toml | sed -E 's/version *= *\"([^\"]+)\"/\\1/')\"",
    "generate:sdk": "pnpm openapi:emit && pnpm fern:check && pnpm generate:sdk:typescript && pnpm generate:sdk:python",
    "generate:cli": "pnpm openapi:emit && pnpm fern:check && ./fern/invoke.sh generate --group local-cli --local --force",
    "generate:all": "pnpm generate:sdk && pnpm generate:cli",
    "cli:build": "pnpm generate:cli && cargo build --release --manifest-path packages/cli/Cargo.toml --bin latitude",
    "cli:run": "packages/cli/target/release/latitude",
    "docs:dev": "cd docs && pnpm dlx mint dev",
    "docs:check": "cd docs && pnpm dlx mint broken-links",
    "prepare": "pnpm hooks && effect-language-service patch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "0.84.3",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "fern-api": "5.50.4",
    "knip": "6.6.2",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=25"
  },
  "version": "0.0.1",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider": "4.0.0-beta.7",
      "@opentelemetry/api": "1.9.1",
      "@react-email/preview-server@5.2.9>next": "16.2.10",
      "drizzle-orm": "1.0.0-beta.15-859cf75",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "hono": "4.12.34",
      "tslib": "2.8.1",
      "protobufjs": "8.7.2",
      "shell-quote@>=1.1.0 <=1.8.3": "1.8.4",
      "srvx": "0.11.21",
      "tmp@<0.2.7": "0.2.7",
      "ws@>=8.0.0 <8.21.1": "8.21.1",
      "undici@<7.0.0": "6.27.0",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "better-auth>zod": "4.3.6",
      "@better-auth/core>zod": "4.3.6",
      "@better-auth/sso>zod": "4.3.6",
      "@better-auth/stripe>zod": "4.3.6",
      "@better-auth/telemetry>zod": "4.3.6"
    }
  }
}
