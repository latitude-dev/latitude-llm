{
  "name": "@repo/operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi/schemas": "./src/openapi/schemas.ts",
    "./openapi/pagination": "./src/openapi/pagination.ts",
    "./openapi/entities/*": "./src/openapi/entities/*.ts"
  },
  "scripts": {
    "check": "biome check src",
    "format": "biome format --write src && biome check --fix src",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --dir src"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@domain/annotations": "workspace:*",
    "@domain/api-keys": "workspace:*",
    "@domain/datasets": "workspace:*",
    "@domain/evaluations": "workspace:*",
    "@domain/exports": "workspace:*",
    "@domain/flaggers": "workspace:*",
    "@domain/incidents": "workspace:*",
    "@domain/monitors": "workspace:*",
    "@domain/oauth-keys": "workspace:*",
    "@domain/organizations": "workspace:*",
    "@domain/projects": "workspace:*",
    "@domain/queue": "workspace:*",
    "@domain/saved-searches": "workspace:*",
    "@domain/scores": "workspace:*",
    "@domain/shared": "workspace:*",
    "@domain/signals": "workspace:*",
    "@domain/spans": "workspace:*",
    "@domain/taxonomy": "workspace:*",
    "@domain/users": "workspace:*",
    "@hono/zod-openapi": "1.3.0",
    "@platform/ai": "workspace:*",
    "@platform/api-key-auth": "workspace:*",
    "@platform/cache-redis": "workspace:*",
    "@platform/db-clickhouse": "workspace:*",
    "@platform/db-postgres": "workspace:*",
    "@platform/env": "workspace:*",
    "@platform/oauth-token-auth": "workspace:*",
    "@platform/queue-bullmq": "workspace:*",
    "@platform/sandbox-quickjs": "workspace:*",
    "@platform/storage-object": "workspace:*",
    "@repo/observability": "workspace:*",
    "effect": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/vitest-config": "workspace:*"
  }
}
