      "properties": {
        "projectSlug": {
          "type": "string",
          "description": "Project slug (human-readable identifier)"
        },
        "fromIso": {
          "description": "Lower bound (inclusive) of the time range. Defaults to 7 days before `toIso`.",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "toIso": {
          "description": "Upper bound (inclusive) of the time range. Defaults to now.",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Tool name. URL-encode names containing special characters."
        },
        "bucketSeconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 7776000,
          "description": "Bucket width in seconds. Derived from the range (~30 buckets) when omitted."
        },
        "errorsOnly": {
          "description": "When `true`, scope every aggregate to failed calls only.",
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      },
      "required": [
        "projectSlug"
      ],
      "additionalProperties": false
    }
  },
